* text=auto eol=lf
*.png binary
*.vsix binary

# Asset files: never convert line endings. Git's guess at "text or binary"
# can be wrong, and a wrong guess corrupts the file. Text formats such as
# .obj, .gltf, .svg, .wgsl and .toml stay text.
